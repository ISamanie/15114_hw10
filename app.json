{
  "expo": {
    "name": "Workout Tracker",
    "slug": "workout-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/workout-icon.png",
    "scheme": "workoutapp",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#01875F",
        "foregroundImage": "./assets/images/workout-mark.png",
        "monochromeImage": "./assets/images/workout-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/workout-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#01875F",
          "image": "./assets/images/workout-mark.png",
          "imageWidth": 142
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Workout Tracker to choose an exercise thumbnail from your photos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
